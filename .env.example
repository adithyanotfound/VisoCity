# ==============================================================================
# VisoAgent / Claude City Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=4100
WEB_ORIGIN=http://127.0.0.1:5173

# Repository & Execution Configuration
SUDO_CITY_REPO=.
SUDO_CITY_MAX_BUDGET_USD=1.00
SUDO_CITY_CLONE_ROOT=.visocity/clones

# AI Agent Configuration (Optional for scaffold, used in Agent orchestrator)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Integration (Optional for local mode, used for OAuth & PR sync)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_TOKEN=
# SESSION_SECRET=change_me_to_a_secure_random_secret_in_production

# Optional Multi-tenant Postgres Database (Falls back to local SQLite in .visocity/world.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/visocity

# Frontend Client URLs (Vite)
VITE_API_URL=http://127.0.0.1:4100
VITE_WS_URL=ws://127.0.0.1:4100/ws
